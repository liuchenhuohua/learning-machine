{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning Machine",
  "version": "2.0.0",
  "identifier": "com.learningmachine.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Learning Machine · 学习机",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 680,
      "dragDropEnabled": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "本地优先的学习项目管理桌面应用",
    "longDescription": "用于管理学习项目书、反馈记录、版本历史、资料与笔记的本地优先桌面应用。",
    "copyright": "Copyright © 2026 Learning Machine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
